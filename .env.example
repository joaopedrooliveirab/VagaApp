# Copie este arquivo para .env.local (o git ignora esse nome) e preencha.
#
# Estas variáveis são lidas SOMENTE pelo servidor (src/app/api). Nunca coloque
# o prefixo EXPO_PUBLIC_ na chave: isso a embutiria dentro do aplicativo.
# Depois de editar, reinicie o servidor (npm start).

# Chave da API da Anthropic (https://console.anthropic.com).
# Sem chave, o app funciona em modo de exemplo, sem IA.
ANTHROPIC_API_KEY=

# Provedor de IA: anthropic ou mock.
# Se ficar vazio: usa anthropic quando há chave e mock quando não há.
LLM_PROVIDER=

# Modelo usado pelo provedor. Se ficar vazio, usa claude-opus-5-5.
# Opções mais baratas e rápidas: claude-sonnet-5-5 ou claude-haiku-5-5.
LLM_MODEL=

# Por padrão, se o filtro de segurança do Claude recusar um pedido, a própria
# Anthropic tenta de novo em outro modelo. Para desativar, tire o # abaixo.
# ANTHROPIC_FALLBACKS=off
